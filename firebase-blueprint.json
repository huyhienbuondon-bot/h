{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "Stores user profile information after Google login.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique Firebase Auth UID." },
        "email": { "type": "string", "format": "email", "description": "User's email address." },
        "phoneNumber": { "type": "string", "description": "User's phone number." },
        "displayName": { "type": "string", "description": "User's display name." },
        "photoURL": { "type": "string", "description": "User's profile picture URL." },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "User role." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user first logged in." },
        "lastLogin": { "type": "string", "format": "date-time", "description": "When the user last logged in." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "When the user profile was last updated." }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "Collection of user profiles."
    }
  }
}
