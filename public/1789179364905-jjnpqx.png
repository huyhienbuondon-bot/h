<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fdfbf7"/>
      <stop offset="100%" stop-color="#f5ede0"/>
    </linearGradient>
    <linearGradient id="yellowShirt" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f59e0b"/>
      <stop offset="100%" stop-color="#d97706"/>
    </linearGradient>
    <linearGradient id="hairGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#3d2b1f"/>
      <stop offset="100%" stop-color="#24140a"/>
    </linearGradient>
    <linearGradient id="skinGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#fff1e8"/>
      <stop offset="100%" stop-color="#fed7c3"/>
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-opacity="0.15"/>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="200" height="200" fill="url(#bgGrad)"/>
  <circle cx="100" cy="100" r="85" fill="#fef3c7" opacity="0.4"/>

  <!-- Yellow T-Shirt (KOL AI GO GLOBAL) -->
  <path d="M45 200 C45 160, 65 145, 80 142 L120 142 C135 145, 155 160, 155 200 Z" fill="url(#yellowShirt)"/>
  <path d="M80 142 Q100 155 120 142 Q100 145 80 142 Z" fill="#b45309"/>
  <!-- Circuit & Tech Logo on Shirt -->
  <circle cx="100" cy="172" r="3" fill="#ffffff" opacity="0.9"/>
  <path d="M100 175 L100 185 M92 178 L100 172 L108 178" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.8"/>
  <text x="100" y="167" font-family="'Plus Jakarta Sans', sans-serif" font-size="6" font-weight="bold" fill="#ffffff" text-anchor="middle" letter-spacing="0.5">KOL AI</text>

  <!-- Neck -->
  <rect x="91" y="125" width="18" height="20" rx="9" fill="url(#skinGrad)"/>

  <!-- Hair Bun on top -->
  <circle cx="100" cy="42" r="22" fill="url(#hairGrad)"/>
  <ellipse cx="94" cy="38" rx="8" ry="6" fill="#4a3525"/>

  <!-- Head Base -->
  <ellipse cx="100" cy="92" rx="36" ry="42" fill="url(#skinGrad)" filter="url(#shadow)"/>

  <!-- Ears -->
  <circle cx="64" cy="94" r="8" fill="#fbcfe8"/>
  <circle cx="136" cy="94" r="8" fill="#fbcfe8"/>
  <circle cx="64" cy="94" r="5" fill="#f9a8d4"/>
  <circle cx="136" cy="94" r="5" fill="#f9a8d4"/>

  <!-- Hair Layers & Cute Bangs -->
  <path d="M64 85 C62 60, 80 48, 100 48 C120 48, 138 60, 136 85 C132 80, 126 62, 100 62 C74 62, 68 80, 64 85 Z" fill="url(#hairGrad)"/>
  <!-- Wispy Bangs -->
  <path d="M82 62 Q90 76 96 74 Q92 64 96 62" fill="url(#hairGrad)"/>
  <path d="M100 62 Q105 76 112 73 Q108 64 112 62" fill="url(#hairGrad)"/>
  <!-- Side strands -->
  <path d="M64 84 C62 100, 68 115, 70 120 C67 114, 64 98, 64 84 Z" fill="url(#hairGrad)"/>
  <path d="M136 84 C138 100, 132 115, 130 120 C133 114, 136 98, 136 84 Z" fill="url(#hairGrad)"/>

  <!-- Eyebrows -->
  <path d="M78 82 Q86 78 94 82" stroke="#3d2b1f" stroke-width="2.5" stroke-linecap="round" fill="none"/>
  <path d="M106 82 Q114 78 122 82" stroke="#3d2b1f" stroke-width="2.5" stroke-linecap="round" fill="none"/>

  <!-- Eyes with lively catchlight -->
  <circle cx="86" cy="94" r="5.5" fill="#1e1b18"/>
  <circle cx="88" cy="92" r="2" fill="#ffffff"/>
  <circle cx="114" cy="94" r="5.5" fill="#1e1b18"/>
  <circle cx="116" cy="92" r="2" fill="#ffffff"/>

  <!-- Round Glasses (Stylish Dark Tortoise Frames) -->
  <!-- Left lens & frame -->
  <circle cx="86" cy="94" r="14" fill="none" stroke="#262626" stroke-width="2.5"/>
  <circle cx="86" cy="94" r="13" fill="#ffffff" fill-opacity="0.15"/>
  <!-- Right lens & frame -->
  <circle cx="114" cy="94" r="14" fill="none" stroke="#262626" stroke-width="2.5"/>
  <circle cx="114" cy="94" r="13" fill="#ffffff" fill-opacity="0.15"/>
  <!-- Glasses bridge -->
  <path d="M98 92 Q100 89 102 92" stroke="#262626" stroke-width="2.5" stroke-linecap="round" fill="none"/>
  <!-- Glasses temples -->
  <line x1="72" y1="92" x2="64" y2="90" stroke="#262626" stroke-width="2.5" stroke-linecap="round"/>
  <line x1="128" y1="92" x2="136" y2="90" stroke="#262626" stroke-width="2.5" stroke-linecap="round"/>

  <!-- Cute Blushing Cheeks -->
  <ellipse cx="76" cy="106" rx="6" ry="3.5" fill="#fb7185" opacity="0.35"/>
  <ellipse cx="124" cy="106" rx="6" ry="3.5" fill="#fb7185" opacity="0.35"/>

  <!-- Dainty Nose -->
  <path d="M99 99 Q100 105 103 104" stroke="#d97706" stroke-width="1.8" stroke-linecap="round" fill="none" opacity="0.6"/>

  <!-- Charming Radiant Smile -->
  <path d="M88 114 Q100 128 112 114 Q100 118 88 114 Z" fill="#e11d48"/>
  <path d="M92 115 Q100 120 108 115" stroke="#ffffff" stroke-width="2" stroke-linecap="round" fill="none"/>

  <!-- Sparkling Star badge in corner -->
  <g transform="translate(145, 145) scale(0.8)">
    <circle cx="15" cy="15" r="16" fill="#0f1f38" stroke="#f59e0b" stroke-width="2"/>
    <text x="15" y="19" font-family="'Plus Jakarta Sans', sans-serif" font-size="8" font-weight="900" fill="#f59e0b" text-anchor="middle">KOL</text>
  </g>
</svg>
