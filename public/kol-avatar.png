<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="100%" height="100%">
  <defs>
    <!-- Background Gradients -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#e0f2fe"/>
      <stop offset="45%" stop-color="#f0f9ff"/>
      <stop offset="85%" stop-color="#fdf4e8"/>
      <stop offset="100%" stop-color="#fef3c7"/>
    </linearGradient>

    <!-- Studio Window & Light Rays -->
    <linearGradient id="windowLight" x1="0%" y1="0%" x2="100%" y2="80%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
    </linearGradient>

    <!-- Yellow T-Shirt (KOL AI GO GLOBAL) -->
    <linearGradient id="yellowShirt" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fbbf24"/>
      <stop offset="40%" stop-color="#f59e0b"/>
      <stop offset="100%" stop-color="#d97706"/>
    </linearGradient>

    <linearGradient id="yellowShirtShade" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#d97706" stop-opacity="0"/>
      <stop offset="100%" stop-color="#b45309" stop-opacity="0.5"/>
    </linearGradient>

    <!-- Hair Bun & Strands -->
    <linearGradient id="hairBase" x1="0%" y1="0%" x2="50%" y2="100%">
      <stop offset="0%" stop-color="#452a1a"/>
      <stop offset="50%" stop-color="#2c1a10"/>
      <stop offset="100%" stop-color="#190e09"/>
    </linearGradient>

    <linearGradient id="hairHighlight" x1="0%" y1="0%" x2="100%" y2="50%">
      <stop offset="0%" stop-color="#8d5b3d"/>
      <stop offset="100%" stop-color="#452a1a"/>
    </linearGradient>

    <!-- Skin Tones -->
    <linearGradient id="skinBase" x1="20%" y1="0%" x2="80%" y2="100%">
      <stop offset="0%" stop-color="#fff5ed"/>
      <stop offset="60%" stop-color="#fedcc8"/>
      <stop offset="100%" stop-color="#fbc7af"/>
    </linearGradient>

    <linearGradient id="skinShadow" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#f8a786" stop-opacity="0"/>
      <stop offset="100%" stop-color="#ea7a55" stop-opacity="0.3"/>
    </linearGradient>

    <!-- Silver Watch Gradient -->
    <linearGradient id="silverWatch" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="50%" stop-color="#cbd5e1"/>
      <stop offset="100%" stop-color="#64748b"/>
    </linearGradient>

    <!-- Soft Drop Shadow Filter -->
    <filter id="softShadow" x="-15%" y="-15%" width="130%" height="130%">
      <feDropShadow dx="0" dy="5" stdDeviation="6" flood-color="#0f1f38" flood-opacity="0.16"/>
    </filter>

    <filter id="handShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="-2" dy="4" stdDeviation="4" flood-color="#7c2d12" flood-opacity="0.22"/>
    </filter>

    <!-- Desk / Studio Gradients -->
    <linearGradient id="deskGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#e2e8f0"/>
    </linearGradient>
  </defs>

  <!-- Background Environment (Creative Studio) -->
  <rect width="400" height="400" fill="url(#bgGrad)"/>

  <!-- Sunlit Studio Window Pane & Bokeh -->
  <path d="M-20 0 L180 0 L80 400 L-40 400 Z" fill="url(#windowLight)" opacity="0.6"/>
  <circle cx="60" cy="80" r="45" fill="#ffffff" opacity="0.25"/>
  <circle cx="340" cy="110" r="60" fill="#fef08a" opacity="0.2"/>
  <circle cx="310" cy="50" r="30" fill="#bae6fd" opacity="0.3"/>

  <!-- Studio Plant Silhouette in Background (Greenery) -->
  <g opacity="0.45" transform="translate(15, 100)">
    <path d="M5 110 C-10 80, -5 40, 20 20 C25 45, 20 85, 15 110" fill="#15803d"/>
    <path d="M15 110 C35 75, 45 40, 60 25 C50 50, 40 85, 25 110" fill="#16a34a"/>
    <path d="M10 110 C15 65, 0 35, 15 5 C25 35, 25 75, 18 110" fill="#22c55e"/>
  </g>

  <!-- White Studio Desk Surface at bottom -->
  <path d="M0 340 L400 325 L400 400 L0 400 Z" fill="url(#deskGrad)"/>
  <line x1="0" y1="340" x2="400" y2="325" stroke="#cbd5e1" stroke-width="2"/>

  <!-- Storyboard Sketchbook & Laptop hint on desk -->
  <g transform="translate(30, 335) rotate(-2)">
    <rect x="0" y="0" width="130" height="55" rx="4" fill="#ffffff" stroke="#94a3b8" stroke-width="1.5"/>
    <rect x="8" y="8" width="32" height="22" rx="2" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="1"/>
    <rect x="46" y="8" width="32" height="22" rx="2" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="1"/>
    <rect x="84" y="8" width="32" height="22" rx="2" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="1"/>
  </g>

  <!-- Sleek Laptop on Right Hint -->
  <path d="M260 360 L390 345 L380 300 L280 308 Z" fill="#0f172a" opacity="0.12"/>

  <!-- CHARACTER BODY & SHOULDERS -->
  <!-- Yellow T-Shirt (KOL AI GO GLOBAL) -->
  <g filter="url(#softShadow)">
    <!-- Main Shirt Body -->
    <path d="M100 380 C105 285, 140 255, 180 250 L250 248 C295 252, 345 280, 365 380 Z" fill="url(#yellowShirt)"/>
    <path d="M100 380 C105 285, 140 255, 180 250 L250 248 C295 252, 345 280, 365 380 Z" fill="url(#yellowShirtShade)"/>

    <!-- T-Shirt Crew Neck Collar -->
    <path d="M180 250 Q215 272 250 248 Q215 262 180 250 Z" fill="#b45309"/>
    <path d="M182 250 Q215 268 248 248" stroke="#fef08a" stroke-width="1.8" fill="none" opacity="0.7"/>

    <!-- Left Shoulder & Sleeve (Raising to Temple) -->
    <path d="M295 255 C335 270, 360 305, 340 365 C325 365, 305 320, 290 280 Z" fill="url(#yellowShirt)"/>
    <!-- Sleeve Creases & Shadows -->
    <path d="M305 275 Q325 295 330 330" stroke="#b45309" stroke-width="2.5" stroke-linecap="round" fill="none" opacity="0.4"/>
  </g>

  <!-- "KOL AI GO GLOBAL" Typography & Circuit Logo on Shirt -->
  <g transform="translate(180, 282) scale(0.85)" opacity="0.95">
    <!-- Circuit Lines & Nodes -->
    <circle cx="45" cy="5" r="2.5" fill="#ffffff"/>
    <path d="M45 7 L45 18 M32 10 L45 5 L58 10" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" fill="none"/>
    <circle cx="32" cy="10" r="2" fill="#ffffff"/>
    <circle cx="58" cy="10" r="2" fill="#ffffff"/>
    <!-- Text -->
    <text x="45" y="32" font-family="'Plus Jakarta Sans', system-ui, -apple-system, sans-serif" font-size="14" font-weight="900" fill="#ffffff" text-anchor="middle" letter-spacing="1.5">KOL AI</text>
    <text x="45" y="44" font-family="'Plus Jakarta Sans', system-ui, -apple-system, sans-serif" font-size="7.5" font-weight="800" fill="#ffffff" text-anchor="middle" letter-spacing="2.2" opacity="0.9">GO GLOBAL</text>
  </g>

  <!-- NECK -->
  <g>
    <path d="M198 220 L198 258 Q215 266 232 258 L232 220 Z" fill="url(#skinBase)"/>
    <path d="M198 222 Q215 240 232 222 L232 235 Q215 250 198 235 Z" fill="url(#skinShadow)"/>
  </g>

  <!-- HEAD & FACE (Slightly tilted thoughtfully to the left) -->
  <g transform="translate(215, 168) rotate(-4) translate(-215, -168)">
    <!-- Back Hair Bun Volume -->
    <circle cx="218" cy="65" r="42" fill="url(#hairBase)"/>
    <!-- Bun Highlights & Messy Bun Loops -->
    <path d="M195 55 C205 35, 235 35, 245 55 C255 75, 235 90, 215 88 C195 85, 185 70, 195 55 Z" fill="url(#hairHighlight)" opacity="0.65"/>
    <circle cx="228" cy="58" r="15" fill="#190e09" opacity="0.5"/>
    <!-- Wispy Hair Strands sticking out of bun -->
    <path d="M235 40 Q255 30 260 45" stroke="#3d2215" stroke-width="2.5" stroke-linecap="round" fill="none"/>
    <path d="M198 42 Q185 30 180 48" stroke="#3d2215" stroke-width="2" stroke-linecap="round" fill="none"/>
    <path d="M218 30 Q225 18 235 25" stroke="#3d2215" stroke-width="2" stroke-linecap="round" fill="none"/>

    <!-- Head / Face Base Shape -->
    <path d="M168 150 C162 110, 180 85, 215 85 C250 85, 268 110, 262 150 C258 190, 240 220, 215 224 C190 220, 172 190, 168 150 Z" fill="url(#skinBase)" filter="url(#softShadow)"/>

    <!-- Soft Cheek Blush (Gentle Radiance) -->
    <ellipse cx="185" cy="180" rx="14" ry="8" fill="#fb7185" opacity="0.32"/>
    <ellipse cx="245" cy="180" rx="14" ry="8" fill="#fb7185" opacity="0.32"/>

    <!-- Ears -->
    <ellipse cx="165" cy="165" rx="8" ry="14" fill="url(#skinBase)"/>
    <ellipse cx="165" cy="165" rx="5" ry="9" fill="#f43f5e" opacity="0.18"/>
    <ellipse cx="265" cy="165" rx="8" ry="14" fill="url(#skinBase)"/>

    <!-- Main Front Hair & Chic Side Bangs -->
    <path d="M165 145 C160 100, 185 85, 215 85 C248 85, 270 100, 265 145 C258 120, 248 102, 215 102 C182 102, 172 120, 165 145 Z" fill="url(#hairBase)"/>
    
    <!-- Soft Wispy Bangs over Forehead -->
    <path d="M190 102 Q198 128 206 122 Q202 108 206 102" fill="url(#hairBase)"/>
    <path d="M210 102 Q218 132 228 124 Q222 108 226 102" fill="url(#hairBase)"/>
    <path d="M178 108 Q182 138 188 132 Q186 116 190 108" fill="url(#hairBase)"/>

    <!-- Long Soft Tendrils Framing Face -->
    <path d="M166 142 C164 165, 170 195, 174 205 C170 192, 166 170, 166 142 Z" fill="url(#hairHighlight)"/>
    <path d="M264 142 C266 165, 260 195, 256 205 C260 192, 264 170, 264 142 Z" fill="url(#hairHighlight)"/>

    <!-- Gentle Curved Eyebrows (Expressive & Natural) -->
    <path d="M182 144 Q195 138 206 144" stroke="#2d170e" stroke-width="3" stroke-linecap="round" fill="none"/>
    <path d="M224 144 Q235 138 248 144" stroke="#2d170e" stroke-width="3" stroke-linecap="round" fill="none"/>

    <!-- Sparkling Eyes Looking Thoughtfully at Storyboard -->
    <!-- Left Eye -->
    <g transform="translate(194, 158)">
      <ellipse cx="0" cy="0" rx="9" ry="6" fill="#ffffff"/>
      <ellipse cx="1" cy="0" rx="5.5" ry="5.5" fill="#261a12"/>
      <circle cx="1" cy="0" r="3.2" fill="#0f172a"/>
      <circle cx="2.5" cy="-1.8" r="1.8" fill="#ffffff"/>
      <circle cx="-0.5" cy="1.5" r="0.9" fill="#ffffff" opacity="0.8"/>
      <!-- Eyelash / Upper Lid -->
      <path d="M-9 -1 Q0 -7 9 -1" stroke="#1c1917" stroke-width="2.6" stroke-linecap="round" fill="none"/>
    </g>

    <!-- Right Eye -->
    <g transform="translate(236, 158)">
      <ellipse cx="0" cy="0" rx="9" ry="6" fill="#ffffff"/>
      <ellipse cx="1" cy="0" rx="5.5" ry="5.5" fill="#261a12"/>
      <circle cx="1" cy="0" r="3.2" fill="#0f172a"/>
      <circle cx="2.5" cy="-1.8" r="1.8" fill="#ffffff"/>
      <circle cx="-0.5" cy="1.5" r="0.9" fill="#ffffff" opacity="0.8"/>
      <!-- Eyelash / Upper Lid -->
      <path d="M-9 -1 Q0 -7 9 -1" stroke="#1c1917" stroke-width="2.6" stroke-linecap="round" fill="none"/>
    </g>

    <!-- Round Tortoiseshell Eyeglasses (Iconic Feature) -->
    <g>
      <!-- Left Rim & Glass -->
      <circle cx="194" cy="158" r="17" fill="#ffffff" fill-opacity="0.12" stroke="#29180d" stroke-width="3.2"/>
      <!-- Left Glass Glare Highlight -->
      <path d="M184 146 Q194 142 202 148" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" fill="none" opacity="0.6"/>

      <!-- Right Rim & Glass -->
      <circle cx="236" cy="158" r="17" fill="#ffffff" fill-opacity="0.12" stroke="#29180d" stroke-width="3.2"/>
      <!-- Right Glass Glare Highlight -->
      <path d="M226 146 Q236 142 244 148" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" fill="none" opacity="0.6"/>

      <!-- Bridge between lenses -->
      <path d="M211 155 Q215 150 219 155" stroke="#29180d" stroke-width="3.2" stroke-linecap="round" fill="none"/>
      
      <!-- Frame Temples extending back -->
      <line x1="177" y1="155" x2="167" y2="152" stroke="#29180d" stroke-width="3" stroke-linecap="round"/>
      <line x1="253" y1="155" x2="263" y2="152" stroke="#29180d" stroke-width="3" stroke-linecap="round"/>
    </g>

    <!-- Delicate Dainty Nose -->
    <path d="M214 162 L213 178 Q217 182 222 179" stroke="#ea580c" stroke-width="1.8" stroke-linecap="round" fill="none" opacity="0.5"/>

    <!-- Thoughtful Gentle Smile with Soft Coral Red Lipstick -->
    <path d="M202 195 Q215 206 228 195 Q215 200 202 195 Z" fill="#e11d48"/>
    <!-- Subtle Teeth shine -->
    <path d="M206 195 Q215 198 224 195" stroke="#ffffff" stroke-width="1.4" stroke-linecap="round" fill="none" opacity="0.9"/>
  </g>

  <!-- LEFT HAND & FOREARM POSE (Resting on Temple - Creative Director Pose) -->
  <g filter="url(#handShadow)">
    <!-- Forearm coming up from bottom right -->
    <path d="M345 350 L300 260 L275 220 C272 205, 285 200, 292 215 L320 270 L380 340 Z" fill="url(#skinBase)"/>

    <!-- Silver Classic Wristwatch -->
    <g transform="translate(305, 275) rotate(-35)">
      <!-- Strap -->
      <rect x="-6" y="-12" width="12" height="24" rx="2" fill="url(#silverWatch)"/>
      <!-- Watch Face -->
      <circle cx="0" cy="0" r="10" fill="#ffffff" stroke="#94a3b8" stroke-width="2"/>
      <circle cx="0" cy="0" r="8" fill="#f8fafc"/>
      <line x1="0" y1="0" x2="0" y2="-5" stroke="#0f172a" stroke-width="1.4" stroke-linecap="round"/>
      <line x1="0" y1="0" x2="4" y2="2" stroke="#0f172a" stroke-width="1.2" stroke-linecap="round"/>
      <!-- Metallic Shine -->
      <circle cx="-3" cy="-3" r="2.5" fill="#ffffff" opacity="0.8"/>
    </g>

    <!-- Hand & Fingers Touching Temple / Glasses Frame -->
    <!-- Palm / Knuckles base -->
    <ellipse cx="272" cy="195" rx="14" ry="16" fill="url(#skinBase)"/>
    <!-- Index finger curved along temple -->
    <path d="M266 182 C262 165, 260 150, 258 142 C255 137, 248 140, 250 148 L256 180 Z" fill="url(#skinBase)"/>
    <!-- Middle finger bent supporting cheek -->
    <path d="M272 186 C270 170, 266 158, 264 154 C260 150, 256 154, 258 162 L266 190 Z" fill="url(#skinBase)"/>
    <!-- Ring finger and pinky curled softly -->
    <path d="M278 192 C276 182, 274 175, 270 174 C267 172, 264 176, 266 184 L272 198 Z" fill="url(#skinBase)"/>
    <path d="M284 198 C282 190, 280 186, 276 186 C274 185, 272 188, 274 194 L278 204 Z" fill="url(#skinBase)"/>

    <!-- Delicate manicure / fingernail sheen -->
    <ellipse cx="254" cy="143" rx="2.5" ry="3.5" fill="#ffffff" opacity="0.45"/>
  </g>

  <!-- Modern Circular Decorative Badge / Brand Accent -->
  <g transform="translate(305, 305)" filter="url(#softShadow)">
    <circle cx="45" cy="45" r="38" fill="#0f1f38" stroke="#f59e0b" stroke-width="3"/>
    <circle cx="45" cy="45" r="33" fill="none" stroke="#fbbf24" stroke-width="1" stroke-dasharray="3,3" opacity="0.7"/>
    <!-- Creative Sparkle Icon -->
    <path d="M45 22 L47 30 L55 32 L47 34 L45 42 L43 34 L35 32 L43 30 Z" fill="#fbbf24"/>
    <!-- Badge Text -->
    <text x="45" y="56" font-family="'Plus Jakarta Sans', system-ui, -apple-system, sans-serif" font-size="9" font-weight="900" fill="#f59e0b" text-anchor="middle" letter-spacing="1">KOL</text>
    <text x="45" y="68" font-family="'Plus Jakarta Sans', system-ui, -apple-system, sans-serif" font-size="7" font-weight="800" fill="#ffffff" text-anchor="middle" letter-spacing="0.5">STORYBOARD</text>
  </g>
</svg>
